{
  "name": "docguard-cli",
  "version": "0.43.0",
  "description": "The enforcement tool for Canonical-Driven Development (CDD). Audit, generate, and guard your project documentation.",
  "type": "module",
  "bin": {
    "docguard": "cli/docguard.mjs"
  },
  "scripts": {
    "docguard": "node cli/docguard.mjs",
    "audit": "node cli/docguard.mjs audit",
    "guard": "node cli/docguard.mjs guard",
    "init": "node cli/docguard.mjs init",
    "score": "node cli/docguard.mjs score",
    "benchmark": "node benchmarks/run.mjs",
    "benchmark:agent-context": "node benchmarks/agent-context/run.mjs",
    "budget": "node tools/budget.mjs ab --head .",
    "generate:precision-evidence": "node benchmarks/generate-precision-evidence.mjs",
    "diff": "node cli/docguard.mjs diff",
    "generate": "node cli/docguard.mjs generate",
    "hooks": "node cli/docguard.mjs hooks",
    "llms": "node tools/generate-llms.mjs",
    "speckit:dev": "specify extension add extensions/spec-kit-docguard --dev --force",
    "prepublishOnly": "node cli/docguard.mjs --version",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "canonical-driven-development",
    "cdd",
    "documentation",
    "governance",
    "ai-agents",
    "spec-kit",
    "spec-driven-development",
    "docguard",
    "validation",
    "cli",
    "developer-tools",
    "documentation-standard"
  ],
  "author": "Ricardo Accioly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raccioly/docguard.git"
  },
  "homepage": "https://github.com/raccioly/docguard#readme",
  "mcpName": "io.github.raccioly/docguard",
  "bugs": {
    "url": "https://github.com/raccioly/docguard/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "7.29.9"
  },
  "files": [
    "cli/",
    "templates/",
    "commands/",
    "extensions/",
    "docs/",
    "!docs/*.pdf",
    "schemas/",
    "STANDARD.md",
    "PRIVACY.md",
    "PHILOSOPHY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ]
}
