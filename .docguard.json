{
  "projectName": "docguard",
  "version": "0.6",
  "profile": "enterprise",
  "projectType": "cli",
  "requiredFiles": {
    "canonical": [
      "docs-canonical/ARCHITECTURE.md",
      "docs-canonical/DATA-MODEL.md",
      "docs-canonical/SECURITY.md",
      "docs-canonical/TEST-SPEC.md",
      "docs-canonical/ENVIRONMENT.md"
    ],
    "agentFile": [
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "changelog": "CHANGELOG.md",
    "driftLog": "DRIFT-LOG.md"
  },
  "projectTypeConfig": {
    "needsEnvVars": false,
    "needsEnvExample": false,
    "needsE2E": false,
    "needsDatabase": false,
    "testFramework": "node:test",
    "runCommand": "node cli/docguard.mjs"
  },
  "securityIgnore": [
    "tests/**"
  ],
  "validators": {
    "structure": true,
    "docsSync": true,
    "drift": true,
    "changelog": true,
    "architecture": true,
    "testSpec": true,
    "security": true,
    "environment": true,
    "freshness": true,
    "documentLifecycle": true,
    "specRegistry": true
  },
  "ownership": {
    "roots": ["cli", "extensions", "tools", "benchmarks", "tests"],
    "entries": [
      { "doc": "docs-canonical/ARCHITECTURE.md", "section": "component-map", "purpose": "What each CLI layer (entry, commands, validators, scanners, writers, evidence, shared modules) is responsible for, and where it sits in the layer graph.", "paths": ["cli/**"] },
      { "doc": "docs-canonical/DATA-MODEL.md", "section": "finding-channels", "purpose": "The finding contract every validator emits: code, severity, confidence, disposition, evidence and parser tier.", "paths": ["cli/findings.mjs"] },
      { "doc": "extensions/spec-kit-docguard/README.md", "purpose": "The Spec Kit extension: its commands, hooks and the scripts they call.", "paths": ["extensions/**"] },
      { "doc": "docs-canonical/ENVIRONMENT.md", "section": "development", "purpose": "Development tools: the llms bundle generator, the non-regression budget runner and the test reporter.", "paths": ["tools/**"] },
      { "doc": "docs-canonical/CI-RECIPES.md", "section": "recipe-4d--detector-precision-regression", "purpose": "The precision benchmark, its corpus and fixtures, and the agent-context benchmark.", "paths": ["benchmarks/**"] },
      { "doc": "docs-canonical/TEST-SPEC.md", "section": "source-to-test-map", "purpose": "Which test files defend which source files, and the fixtures they use.", "paths": ["tests/**"] }
    ]
  },
  "diagrams": {
    "moduleGraph": { "include": ["cli"] }
  },
  "specFirst": {
    "paths": ["cli/**"]
  },
  "severity": {},
  "findingSeverity": {},
  "surfaceSync": {
    "surfaces": [
      {
        "name": "commands",
        "glob": "cli/commands/*.mjs",
        "extract": "basename-no-ext",
        "ignore": [
          "agents", "hooks", "ci", "badge", "llms", "publish",
          "setup", "impact", "sync-tests", "generate-as-built"
        ],
        "docs": ["README.md"],
        "section": "Usage"
      },
      {
        "name": "validators",
        "glob": "cli/validators/*.mjs",
        "extract": "basename-no-ext",
        "ignore": [
          "drift",
          "doc",
          "doc-sections",
          "drift-comments"
        ],
        "docs": ["README.md"],
        "section": "Validators"
      },
      {
        "name": "slash-commands",
        "glob": "templates/commands/*.md",
        "extract": "basename-no-ext",
        "docs": ["README.md"],
        "section": "Slash Commands"
      }
    ]
  }
}
