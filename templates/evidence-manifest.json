{
  "$schema": "https://raccioly.github.io/docguard/schemas/docguard-evidence.schema.json",
  "schemaVersion": 1,
  "declarations": [
    {
      "id": "policy.retention-days",
      "applicability": { "mode": "always" },
      "target": {
        "document": "docs-canonical/SECURITY.md",
        "heading": "Data retention",
        "statement": "Audit records are retained for {{value}} days."
      },
      "source": {
        "adapter": "json-pointer",
        "path": "config/policy.json",
        "pointer": "/retentionDays"
      },
      "predicate": { "kind": "equals", "valueType": "number" }
    },
    {
      "id": "surface.python-scanners",
      "applicability": { "mode": "always" },
      "target": {
        "document": "docs-canonical/ARCHITECTURE.md",
        "heading": "Scanner registry",
        "statement": "The registry contains {{value}} scanners."
      },
      "source": {
        "adapter": "python-literal-count",
        "path": "src/package/scanners.py",
        "symbol": "SCANNERS",
        "allowEmpty": false
      },
      "predicate": { "kind": "count-equals" }
    }
  ]
}
