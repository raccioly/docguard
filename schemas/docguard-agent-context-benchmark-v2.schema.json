{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raccioly.github.io/docguard/schemas/docguard-agent-context-benchmark-v2.schema.json",
  "title": "DocGuard agent-context benchmark, protocol v2 (symbol map)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "protocol",
    "conditions",
    "promotion",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "const": "https://raccioly.github.io/docguard/schemas/docguard-agent-context-benchmark-v2.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frozenAt",
        "seed",
        "repetitions",
        "timeoutMs",
        "harness",
        "model"
      ],
      "properties": {
        "id": {
          "const": "docguard-agent-context-v2"
        },
        "frozenAt": {
          "type": "string",
          "format": "date"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "repetitions": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cliVersion",
            "id",
            "reasoningEffort",
            "sandbox"
          ],
          "properties": {
            "cliVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reasoningEffort": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "sandbox": {
              "const": "workspace-write"
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "task-only"
        },
        {
          "const": "context-pack"
        },
        {
          "const": "context-pack-symbols"
        }
      ],
      "items": false
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "baseline",
        "noRegression",
        "benefit"
      ],
      "properties": {
        "candidate": {
          "const": "context-pack-symbols"
        },
        "baseline": {
          "const": "context-pack"
        },
        "noRegression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAdditionalFailures",
            "maxAdditionalRequirementViolations",
            "maxAdditionalUnnecessaryEdits",
            "maxMedianIncreasePercent"
          ],
          "properties": {
            "maxAdditionalFailures": {
              "const": 1
            },
            "maxAdditionalRequirementViolations": {
              "const": 0
            },
            "maxAdditionalUnnecessaryEdits": {
              "const": 0
            },
            "maxMedianIncreasePercent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uncachedInputTokens",
                "steps"
              ],
              "properties": {
                "uncachedInputTokens": {
                  "const": 5
                },
                "steps": {
                  "const": 5
                }
              }
            }
          }
        },
        "benefit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "successGainQualifies",
            "minimumMedianReductionPercent",
            "measures",
            "scope"
          ],
          "properties": {
            "successGainQualifies": {
              "const": true
            },
            "minimumMedianReductionPercent": {
              "const": 15
            },
            "measures": {
              "const": [
                "steps",
                "latency"
              ]
            },
            "scope": {
              "const": "navigation-bound"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture",
        "hiddenEvaluator",
        "reference",
        "prompt",
        "allowedChanges",
        "visibleTest",
        "expectedInitial",
        "navigationBound",
        "fixtureDigest",
        "evaluatorDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "fixture": {
          "$ref": "#/$defs/path"
        },
        "hiddenEvaluator": {
          "$ref": "#/$defs/path"
        },
        "reference": {
          "$ref": "#/$defs/path"
        },
        "prompt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "allowedChanges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "visibleTest": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "expectedInitial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 1
            },
            "failed": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "navigationBound": {
          "type": "boolean",
          "description": "The prompt names a requirement, not a file, and the fixture has 25 or more source modules."
        },
        "fixtureDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Frozen digest of the fixture tree; any later edit is rejected."
        },
        "evaluatorDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Frozen digest of the hidden evaluator; the measuring instrument cannot change after freezing."
        }
      }
    }
  }
}
