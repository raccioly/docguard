# DocGuard Ignore — files to exclude from validation
# Format: one pattern per line, # comments, blank lines skipped

# Research documents (external/archival — not project source docs)
Research/
Research/**

# Python distribution artifacts
dist/
build/
*.egg-info/
docguard_cli/
__pycache__/
*.pyc

# OS files
.DS_Store

# Spec Kit templates and scripts (contain placeholder tokens, not actual docs)
.specify/templates/
.specify/scripts/

# Backups created by generate --force
*.bak

# Surface audit doc — contains historical observations like "guard ran 22
# validators" that document the pre-v0.19 state. Auto-fixing those to the
# current count would erase the historical record the audit exists to preserve.
docs-canonical/SURFACE-AUDIT.md

# Fixture/demo projects and packaging working notes — their .md files are
# example content, not this project's documentation (doc-coverage tiering).
# specs/ is deliberately NOT ignored: the Spec-Kit validator owns those.
examples/
examples/**
templates/demo-fixture/
templates/demo-fixture/**
benchmarks/fixtures/
benchmarks/fixtures/**
# Requirement-anchor fixture projects (specs/070): their tags cite the fixture's
# own example specs (acme.billing), not this repository's requirements.
tests/fixtures/anchors/
tests/fixtures/anchors/**
packaging/
packaging/**


# Generated audit reports and probe templates are historical tool output, not product source.
websec-out/
websec-out/**
graphify-out/
graphify-out/**

# Generated from cli/findings.mjs (npm run docs:reference; drift-tested by
# tests/user-docs.test.mjs). Each code's help quotes the phrases its detector
# looks for, so validating the page would report the detectors' own examples.
docs/reference/findings.md

# Anchor-oracle corpus: idiomatic code in every pattern-tier language, parsed by
# tree-sitter in CI to measure the pattern tier (specs/070-requirement-anchors
# FR-040). It is a measurement input, not project source.
tools/anchor-oracle/corpus/
tools/anchor-oracle/corpus/**
